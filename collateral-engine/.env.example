# Every variable is optional; defaults suit a local checkout of the repository.

# Directory with valuation_policy.yaml, condition_rules.yaml and vehicle_policy.yaml.
COLLATERAL_CONFIG_DIR=
# Comparable sales CSV in the data contract of src/collateral_engine/market.py.
COLLATERAL_MARKET_DATA_PATH=
# Vehicle sales CSV in the data contract of src/collateral_engine/vehicles/market.py.
COLLATERAL_VEHICLE_MARKET_DATA_PATH=
# Shown on every report and in the console, so nobody mistakes synthetic sales for real ones.
COLLATERAL_MARKET_DATA_SOURCE=
# NBG PTI/LTV rules shared with the income engine.
NBG_RULES_PATH=
# SQLite file of the audit log and the photo registry.
COLLATERAL_AUDIT_DB_PATH=
# Evidence photos, stored under their SHA-256.
COLLATERAL_EVIDENCE_DIR=
# true sends usable photos to the vision model.
COLLATERAL_VISION_ENABLED=
# nvidia (default, needs NVIDIA_API_KEY) or anthropic (needs ANTHROPIC_API_KEY).
COLLATERAL_VISION_PROVIDER=
# Defaults: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning or claude-opus-5-5.
COLLATERAL_VISION_MODEL=
COLLATERAL_VISION_TIMEOUT_S=
NVIDIA_API_KEY=
NVIDIA_CHAT_URL=
ANTHROPIC_API_KEY=
# NBG official exchange rate API.
NBG_RATES_URL=
NBG_RATES_TIMEOUT_S=
# Income engine (income-engine/): trained models and its synthetic borrowers for the demo.
INCOME_MODELS_DIR=
INCOME_DATA_DIR=
# When set, /v1/income/* and /v1/full-applications need the header X-API-Key with this value.
ITE_API_KEY=
# Loan application pipeline: the NBG hackathon dataset and our Open Banking gateway (server/).
NBG_DATASET_PATH=
OPEN_BANKING_GATEWAY_URL=
OPEN_BANKING_TIMEOUT_S=
