# HTTP port the gateway listens on (1-65535).
PORT=3000
# AIS base URL of the TBC mock Open Banking sandbox, including the API version prefix.
TBC_API_BASE_URL=https://tbc-bank-mock-open-banking-api.vercel.app/0.8
# OAuth authorization endpoint where the PSU approves the consent at the bank.
TBC_OAUTH_AUTHORIZE_URL=https://tbc-bank-mock-open-banking-api.vercel.app/psd2/openbanking/oauth/authorize
# OAuth token endpoint for the authorization code and refresh token grants.
TBC_OAUTH_TOKEN_URL=https://tbc-bank-mock-open-banking-api.vercel.app/openbanking/oauth/token
# Public OAuth client id of the gateway; the sandbox uses no client secret.
TBC_OAUTH_CLIENT_ID=virtual-field-visit-gateway
# Callback URL of this gateway; sent as TPP-Redirect-URI and OAuth redirect_uri.
TBC_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
# Language of the bank consent screen: en or ka.
TBC_OAUTH_UI_LOCALE=en
# Timeout of a single sandbox request attempt in milliseconds (100-60000).
TBC_HTTP_TIMEOUT_MS=8000
# Total attempts for idempotent GET requests to the sandbox, first attempt included (1-3).
TBC_RETRY_MAX_ATTEMPTS=3
# Base delay of the exponential retry backoff in milliseconds (0-10000).
TBC_RETRY_BASE_DELAY_MS=250
# Upper bound of a single retry delay in milliseconds (0-30000, not below the base delay).
TBC_RETRY_MAX_DELAY_MS=2000
# Lifetime of a pending OAuth state and PKCE verifier in milliseconds (10000-3600000).
OAUTH_STATE_TTL_MS=600000
# Refresh the access token when it expires within this many milliseconds (0-600000).
OAUTH_TOKEN_REFRESH_MARGIN_MS=60000
# Organizer dataset workbook; a relative path is resolved against the working directory.
DATASET_XLSX_PATH=../data/open-banking-synthetic-100-customers.xlsx
